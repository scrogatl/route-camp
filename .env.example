# Copy to .env to override defaults. Nothing here is required.

# Region to route in. Any Geofabrik extract works (e.g. north-america/us/california-latest.osm.pbf).
OSM_URL=https://download.geofabrik.de/north-america/us/georgia-latest.osm.pbf
OSM_FILE=georgia-latest.osm.pbf
# Used as the graph-cache folder name. Change it together with OSM_URL so each region has its own cache.
REGION_NAME=georgia

# Basemap style for the frontend.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Garmin GPX export: a shaping point about every this many km along the route (0 = none), and the most
# route points (stops + shaping points) in one exported route.
SHAPING_SPACING_KM=10
MAX_ROUTE_POINTS=50

# Host ports. The backend default avoids 8000, which is often taken.
BACKEND_PORT=8080
FRONTEND_PORT=5173
